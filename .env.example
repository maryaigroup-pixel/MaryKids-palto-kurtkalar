# ===== Sayt =====
# Saytning to'liq manzili (oxirida / qo'ymang). Purchase havolasi shu domen bilan yasaladi.
NEXT_PUBLIC_SITE_URL=https://marykids.uz

# Lid qoldirgandan keyin mijoz yo'naltiriladigan Telegram kanal
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/marykids_uz

# ===== Telegram bot =====
# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Lidlar keladigan chat/guruh ID (guruh bo'lsa -100... bilan boshlanadi)
TELEGRAM_CHAT_ID=-1001234567890

# ===== Meta (Facebook) =====
# Events Manager -> Data sources -> Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
# Events Manager -> Settings -> Conversions API -> Generate access token
META_CAPI_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxx
# Graph API versiyasi
META_API_VERSION=v23.0
# Test qilish uchun (Events Manager -> Test events). Ishga tushirganda bo'sh qoldiring!
META_TEST_EVENT_CODE=

# Purchase qiymati Meta'ga qaysi valyutada ketadi: USD (tavsiya) yoki UZS
META_CURRENCY=USD
# 1 USD necha so'm (META_CURRENCY=USD bo'lsa so'm avtomatik USD ga aylantiriladi)
USD_UZS_RATE=12700

# ===== Xavfsizlik =====
# Havoladagi ma'lumotlarni shifrlash kaliti (kamida 32 belgili tasodifiy matn)
# Yaratish: openssl rand -hex 32
LINK_SECRET=change-me-to-a-long-random-string-min-32-chars
# Ixtiyoriy: purchase sahifasida summa yuborishda so'raladigan PIN kod
ADMIN_PIN=
